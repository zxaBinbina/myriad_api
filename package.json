{
  "name": "myriad-api",
  "private": true,
  "version": "0.1.0",
  "description": "万象（Myriad）的 Cloudflare Worker 后端：同步、备份、图标代理与数据接口。",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787 --local-upstream 127.0.0.1:8787",
    "deploy": "wrangler deploy",
    "types": "wrangler types --include-runtime false",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "wrangler d1 migrations apply myriad --remote",
    "db:migrate:local": "wrangler d1 migrations apply myriad --local",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "hono": "^4.13.17",
    "jose": "^6.2.15",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@cloudflare/workers-types": "^5.20261107.1",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "engines": {
    "node": ">=22"
  }
}
